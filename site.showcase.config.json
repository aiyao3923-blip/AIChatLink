{
  "projectName": "AIChatLink Pages",
  "root": ".",
  "type": "static-html",
  "installCommand": null,
  "startCommand": null,
  "baseUrl": "http://127.0.0.1:4178",
  "outputDir": "site/assets",
  "readme": "README.md",
  "waitMs": 800,
  "timeoutMs": 30000,
  "disableAnimations": true,
  "viewports": {
    "desktop": {
      "width": 1280,
      "height": 720
    }
  },
  "screenshots": [
    {
      "id": "aichatlink-orbit",
      "title": "AIChatLink broker and CLI agents",
      "path": "/",
      "viewport": "desktop",
      "waitFor": ".orbit",
      "waitMs": 500,
      "fullPage": false,
      "selector": ".orbit",
      "steps": []
    },
    {
      "id": "pages-home",
      "title": "AIChatLink GitHub Pages home",
      "path": "/",
      "viewport": "desktop",
      "waitFor": ".hero",
      "waitMs": 500,
      "fullPage": false,
      "selector": null,
      "steps": []
    }
  ]
}
